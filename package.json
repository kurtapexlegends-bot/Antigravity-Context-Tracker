{
  "name": "antigravity-context-tracker",
  "displayName": "Antigravity Active Context Tracker",
  "description": "Tracks, visualizes, compacts, and analyzes active conversation context, token usage, and step timeline in real time for Antigravity IDE and VS Code.",
  "version": "0.3.3",
  "publisher": "antigravity",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "antigravity-context-sidebar",
          "title": "Antigravity Context Tracker",
          "icon": "$(pulse)"
        }
      ]
    },
    "views": {
      "antigravity-context-sidebar": [
        {
          "type": "webview",
          "id": "antigravity-context-view",
          "name": "Active Conversation Context"
        }
      ]
    },
    "commands": [
      {
        "command": "antigravity-context.refresh",
        "title": "Antigravity Context: Refresh Active Context",
        "icon": "$(refresh)"
      },
      {
        "command": "antigravity-context.compactSession",
        "title": "Antigravity Context: Compact Current Conversation Tab (In-Place)",
        "icon": "$(zap)"
      },
      {
        "command": "antigravity-context.exportSummary",
        "title": "Antigravity Context: Export Context Digest (Markdown)",
        "icon": "$(export)"
      },
      {
        "command": "antigravity-context.selectSession",
        "title": "Antigravity Context: Select Conversation Session",
        "icon": "$(history)"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/node": "^18.11.9",
    "@types/vscode": "^1.75.0",
    "typescript": "^5.0.0"
  }
}
